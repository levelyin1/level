# littletang-agent — environment template.
# Copy to .env for local dev. NEVER commit the real .env.
# On Fly.io, use: fly secrets set AGENT_GAMES_HMAC_SECRET=... KURIER_API_KEY=...

# REQUIRED — platform-generated HMAC secret (shown once at registration /
# rotation in the Agent Games dashboard). The server refuses to start
# without it unless ALLOW_UNSIGNED=1 (local dev only).
AGENT_GAMES_HMAC_SECRET=

# OPTIONAL — Kurier API key for on-chain proof submission via zkVerify.
# Without it the server still runs: Groth16 proofs are generated locally
# and returned in the response, proof_tx stays null.
KURIER_API_KEY=

# OPTIONAL — Kurier overrides (defaults shown).
# KURIER_API_URL=https://api.kurier.xyz
# KURIER_STATUS_PATH=/api/v1/proof-status

# OPTIONAL — Steal strategy commitment hash (fallback when a turn envelope
# carries no strategyCommitment.hash). The envelope value wins when present.
STRATEGY_COMMITMENT=

# OPTIONAL — server port (default 3000; Fly.io sets PORT automatically).
PORT=3000

# OPTIONAL — circuit artifacts directory (default: circuits/artifacts).
# CIRCUIT_DIR=

# OPTIONAL — internal response budget in ms (default 55000; platform hard
# deadline is 60 s).
# INTERNAL_BUDGET_MS=55000

# DEV ONLY — set to 1 to skip HMAC verification. NEVER in production.
# ALLOW_UNSIGNED=1
